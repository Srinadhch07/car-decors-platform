# Car Decor Platform — Frontend environment template.
#
# Development: copy to `.env` (Vite loads it automatically). The dev server
# proxies /api and /media to the local FastAPI backend, or you can point
# VITE_API_BASE_URL at it directly.
# Production:   copy to `.env.production` (used by `vite build`). Set the
# deployed backend URL here. NEVER put secrets in frontend env files (they are
# inlined into the public bundle).

VITE_API_BASE_URL=