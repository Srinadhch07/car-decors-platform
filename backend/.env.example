# Car Decor Platform — Backend environment template.
#
# Development: copy to `.env` and fill values. The app reads `.env` when
# APP_ENV is unset or `development`.
# Production:   provide these values through the deployment platform's
# environment (recommended) OR copy this file to `.env.production` when the
# app is started with APP_ENV=production. NEVER commit real secrets.
# Values here are placeholders only.

# Application
APP_NAME=Car Decor Platform API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=car_decor
MONGO_TIMEOUT_MS=3000

# CORS (comma-separated origins, no wildcard when credentials are enabled)
CORS_ORIGINS=http://localhost:5173

# Authentication / sessions.
# For production set a strong random JWT_SECRET (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`).
# When empty in development an ephemeral random secret is generated at startup;
# in production the app refuses to start without one.
JWT_SECRET=
JWT_ACCESS_MINUTES=30
COOKIE_NAME=car_decor_session
CSRF_COOKIE_NAME=car_decor_csrf
COOKIE_DOMAIN=
# Cookie Secure flag: keep false for local http, MUST be true behind https.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Login rate limiting (per client IP).
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Password reset by email (Gmail SMTP). These values go into the PUBLIC API's
# backend configuration ONLY - never expose them to the frontend (no VITE_*),
# never commit them. SMTP_PASSWORD is a Google "App Password" (16 chars), not
# your normal Gmail password; create one in Google Account -> Security ->
# 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Origin of the customer-facing site; the backend builds password-reset links
# from this (e.g. https://shop.example.com). Never put credentials in the URL.
FRONTEND_URL=http://localhost:5173
# Lifetime of a single-use password-reset token.
PASSWORD_RESET_TOKEN_MINUTES=30
# Forgot-password and reset-password rate limiting (per client IP).
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
RESET_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15

# Seeding (used by `python scripts/seed.py`)
SEED_ADMIN_EMAIL=admin@example.com
# Plaintext password for the dev admin; hashed with Argon2id at seed time.
# This is a development convenience - never a real credential, and keep .env
# out of version control.
SEED_ADMIN_PASSWORD=dev-only-change-me
# Advanced override: a pre-computed hash wins over the plaintext above.
SEED_ADMIN_PASSWORD_HASH=
SEED_SAMPLE_DATA=false

# Image storage.
# STORAGE_MODE=local (development, no credentials) or s3 (Amazon S3).
# In local mode files are written to STORAGE_LOCAL_DIR and served at /media.
STORAGE_MODE=local
STORAGE_LOCAL_DIR=storage-local
# Product image upload limit in bytes (5 MB).
PRODUCT_IMAGE_MAX_BYTES=5242880

# Amazon S3 (only used when STORAGE_MODE=s3). Keep out of version control.
# IAM credentials must have s3:PutObject, s3:DeleteObject, and s3:HeadObject
# on the bucket; product images are served through a public-read URL.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
# Optional public CDN/static URL prefix; when empty the standard
# https://<bucket>.s3.<region>.amazonaws.com/<key> URL is used.
# AWS_S3_PUBLIC_URL=